SLURM_COMPOSE_FILE=infra/docker/docker-compose.yml
SLURM_SERVICE=slurm
SLURM_EXEC_MODE=docker
# Optional for SLURM_EXEC_MODE=ssh
SLURM_SSH_HOST=
SLURM_SSH_USER=
SLURM_SSH_KEY_FILE=
# Timeout (seconds) for every Slurm CLI call made through SlurmCommandRunner.
SLURM_EXEC_TIMEOUT_SEC=30
# Verify SSH host keys for SLURM_EXEC_MODE=ssh; keep true outside throwaway sandboxes.
SLURM_SSH_STRICT_HOST_KEY=true
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
# Grafana admin credentials — GRAFANA_ADMIN_PASSWORD is required (no default) by
# infra/docker/docker-compose.yml; set both before running ./scripts/up.sh.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
API_PORT=8080
# Host/interface the FastAPI app (apps/api/main.py) binds to; loopback-only by default.
API_BIND_HOST=127.0.0.1
# Bearer token required on /cluster/snapshot and /metrics. Empty = endpoints stay open.
CONTROLLER_API_TOKEN=
# Per-client-IP requests/minute across all routes; 429 past the limit. <= 0 disables.
CONTROLLER_API_RATE_LIMIT_PER_MIN=120
# Comma-separated CORS origin allowlist. Empty/unset = same-origin only (no cross-origin
# reads). Credentials are never allowed, so "*" is safe but broad. e.g. https://dash.example
CONTROLLER_API_ALLOWED_ORIGINS=
CONTROLLER_INTERVAL_SEC=15
CONTROLLER_DRY_RUN=true
CONTROLLER_COOLDOWN_SEC=60
MAX_JOBS_FLOOR=2
MAX_JOBS_CEIL=128
PRESSURE_HIGH=0.85
PRESSURE_LOW=0.45
